{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "SharedKey": "",
    "EdgeSecret": ""
  },
  "Chat": {
    "GroqApiKey": "",
    "GroqModel": "openai/gpt-oss-120b"
  },
  "Cors": {
    "Origins": [
      "http://localhost:8080",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-read": {
        "ClusterId": "catalog",
        "CorsPolicy": "web",
        "Match": {
          "Path": "/api/catalog/{**rest}",
          "Methods": [
            "GET",
            "OPTIONS"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/catalog"
          }
        ]
      },
      "catalog-admin": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/admin/catalog/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/admin/catalog"
          },
          {
            "PathPrefix": "/admin"
          }
        ]
      },
      "localization-read": {
        "ClusterId": "localization",
        "CorsPolicy": "web",
        "Match": {
          "Path": "/api/localization/{**rest}",
          "Methods": [
            "GET",
            "OPTIONS"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/localization"
          }
        ]
      },
      "localization-admin": {
        "ClusterId": "localization",
        "Match": {
          "Path": "/api/admin/localization/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/admin/localization"
          },
          {
            "PathPrefix": "/admin"
          }
        ]
      },
      "review-read": {
        "ClusterId": "review",
        "CorsPolicy": "web",
        "Match": {
          "Path": "/api/reviews/{**rest}",
          "Methods": [
            "GET",
            "OPTIONS"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reviews"
          }
        ]
      },
      "review-write": {
        "ClusterId": "review",
        "CorsPolicy": "web",
        "RateLimiterPolicy": "public-write",
        "Match": {
          "Path": "/api/reviews/{**rest}",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reviews"
          }
        ]
      },
      "review-admin": {
        "ClusterId": "review",
        "Match": {
          "Path": "/api/admin/reviews/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/admin/reviews"
          },
          {
            "PathPrefix": "/admin"
          }
        ]
      },
      "submission-write": {
        "ClusterId": "submission",
        "CorsPolicy": "web",
        "RateLimiterPolicy": "public-write",
        "Match": {
          "Path": "/api/submissions",
          "Methods": [
            "POST",
            "OPTIONS"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/submissions"
          }
        ]
      },
      "submission-admin": {
        "ClusterId": "submission",
        "Match": {
          "Path": "/api/admin/submissions/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/admin/submissions"
          },
          {
            "PathPrefix": "/admin/submissions"
          }
        ]
      },
      "analytics-track": {
        "ClusterId": "analytics",
        "CorsPolicy": "web",
        "RateLimiterPolicy": "tracking",
        "Match": {
          "Path": "/api/analytics/{**rest}",
          "Methods": [
            "POST",
            "OPTIONS"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/analytics"
          }
        ]
      },
      "analytics-admin": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/admin/analytics/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/admin/analytics"
          },
          {
            "PathPrefix": "/admin"
          }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "localization": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "review": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "submission": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "analytics": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105"
          }
        }
      }
    }
  },
  "Admin": {
    "Enabled": false
  }
}
