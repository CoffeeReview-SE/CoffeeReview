# SQL Server connection for Data/Database.sql
DB_SERVER=localhost
DB_NAME=ElectronicCommerceDB
# For a local SQL Express instance, use Windows Authentication and its instance name.
DB_INSTANCE=SQLEXPRESS
DB_TRUSTED_CONNECTION=true
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# For SQL authentication instead, set DB_TRUSTED_CONNECTION=false, remove DB_INSTANCE,
# set DB_PORT (usually 1433), and provide DB_USER and DB_PASSWORD.
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Existing Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PORT=3333
