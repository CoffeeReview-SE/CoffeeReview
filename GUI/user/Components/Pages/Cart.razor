@page "/cart"
@inherits ShopPageBase
<PageTitle>@PageName — SmartShop</PageTitle>
<h1>Giỏ hàng <span class="muted">(@Shop.Count)</span></h1><p class="subtitle">Những lựa chọn tuyệt vời đang chờ bạn.</p>
@if (Shop.Count == 0)
{
    <EmptyState Icon="♧" Title="Giỏ hàng của bạn đang trống"
                Message="Khám phá những sản phẩm công nghệ yêu thích." ActionText="Tiếp tục mua sắm"
                OnAction='() => Go("products")' />
}
else{<div class="two-column"><section class="panel">@foreach(var line in Shop.Cart.ToList()){var p=Shop.Products.Single(p=>p.Id==line.Key);<div class="cart-line"><Device Category="@p.Category" Color="@p.Color"/><div class="cart-description"><h3>@p.Name</h3><p>@p.Spec</p><strong>@MoneyFormatter.Format(p.Price)</strong></div><div class="quantity"><button aria-label="Giảm số lượng" @onclick="()=>Change(p.Id,-1)">−</button><span>@line.Value</span><button aria-label="Tăng số lượng" @onclick="()=>Change(p.Id,1)">+</button></div><button class="text-button" @onclick="()=>Remove(p.Id)">Xóa</button></div>}</section><section class="panel summary"><h2>Tóm tắt đơn hàng</h2><p>Tạm tính <strong>@MoneyFormatter.Format(Shop.Total)</strong></p><p>Phí giao hàng <span class="green">Miễn phí</span></p><hr/><p>Tổng cộng <strong class="red">@MoneyFormatter.Format(Shop.Total)</strong></p><small>Đã bao gồm VAT · Dữ liệu demo</small><button class="primary wide" @onclick='()=>Go("checkout")'>Tiến hành đặt hàng →</button><button class="text-button wide" @onclick='()=>Go("products")'>Tiếp tục mua sắm</button></section></div>}
