<div class="customer-selector">
    <FormField Label="Nhà cung cấp đã chọn">
        <input readonly value="@Display" aria-label="Nhà cung cấp đã chọn" />
    </FormField>
    <button type="button" class="secondary" aria-label="Tìm và chọn nhà cung cấp" @onclick="() => open = true">… Chọn nhà cung cấp</button>
</div>
@if (open)
{
    <SupplierPicker OnSelected="Select" OnClose="() => open = false" />
}

@code {
    [Parameter] public Supplier? Value { get; set; }
    [Parameter] public EventCallback<Supplier?> ValueChanged { get; set; }
    private bool open;
    private string Display => Value is null ? "Chưa chọn nhà cung cấp" : $"{Value.Code} — {Value.Name} — {Value.Phone}";
    private Task Select(Supplier supplier) => ValueChanged.InvokeAsync(supplier);
}
