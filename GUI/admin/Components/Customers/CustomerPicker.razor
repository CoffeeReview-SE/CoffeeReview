@inject ICustomerService Customers

<ModalDialog Label="Tìm và chọn khách hàng" CssClass="customer-modal" OnClose="OnClose">
    <h2>Tìm và chọn khách hàng</h2>
    <p class="customer-help">@(OnlyActive ? "Chỉ hiển thị khách hàng đang hoạt động." : "Tìm theo mã, tên, số điện thoại, email hoặc địa chỉ.")</p>
    <div class="customer-search">
        <input aria-label="Tìm khách hàng trong popup" placeholder="Nhập mã, tên, số điện thoại..."
               @bind="query" @bind:event="oninput" />
    </div>
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="customer-feedback error" role="alert">@error</div>
    }
    <DataTable TItem="Customer" Items="Results" Label="Kết quả chọn khách hàng" ColumnCount="4" EmptyText="Không tìm thấy khách hàng phù hợp.">
        <Header><th scope="col">Khách hàng</th><th scope="col">Liên hệ</th><th scope="col">Trạng thái</th><th scope="col">Chọn</th></Header>
        <RowTemplate Context="customer">
            <td><strong>@customer.Name</strong><small>@customer.Code</small></td>
            <td>@customer.Phone<small>@customer.Email</small></td>
            <td>@(customer.IsActive ? "Hoạt động" : "Đã khóa")</td>
            <td><button type="button" class="text-button" aria-label="Chọn @customer.Code" @onclick="() => Choose(customer.Id)">Chọn →</button></td>
        </RowTemplate>
    </DataTable>
    <div class="customer-actions"><button type="button" class="secondary" @onclick="OnClose">Đóng tìm kiếm</button></div>
</ModalDialog>

@code {
    [Parameter] public bool OnlyActive { get; set; } = true;
    [Parameter] public EventCallback<Customer> OnSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string query = "", error = "";
    private IReadOnlyList<Customer> Results => Customers.Search(query, OnlyActive ? true : null);

    private async Task Choose(int id)
    {
        try
        {
            var value = Customers.Get(id);
            if (OnlyActive && !value.IsActive) throw new InvalidOperationException("Khách hàng này đã bị khóa.");
            await OnSelected.InvokeAsync(value);
            await OnClose.InvokeAsync();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
