@page "/admin/suppliers"
@layout SmartShop.Admin.Components.Layout.AdminLayout
@inject ISupplierService SupplierService

<PageTitle>Quản lý nhà cung cấp — SmartShop</PageTitle>
<div class="section-heading customer-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / NHÀ CUNG CẤP</div>
        <h1>Quản lý nhà cung cấp</h1>
        <p class="subtitle">Quản lý thông tin liên hệ của các nhà cung cấp.</p>
    </div>
    <button type="button" class="primary" @onclick="Create">+ Thêm nhà cung cấp</button>
</div>
<p class="customer-help">Dữ liệu demo theo phiên.</p>
@if (!string.IsNullOrEmpty(message))
{
    <div class="customer-feedback @(failed ? "error" : "")" role="status">@message</div>
}
<section class="panel">
    <div class="customer-toolbar">
        <div class="customer-search"><input aria-label="Tìm nhà cung cấp" placeholder="Tìm mã, tên, điện thoại, email..." @bind="query" @bind:event="oninput" /></div>
        <button type="button" class="text-button" @onclick='() => query = ""'>Xóa tìm kiếm</button>
    </div>
    <SupplierSelector @bind-Value="selectedLookup" />
    <p class="customer-help">@Rows.Count kết quả · Có thể cuộn ngang bảng trên điện thoại.</p>
    <DataTable TItem="Supplier" Items="Rows" Label="Danh sách nhà cung cấp" ColumnCount="5" EmptyText="Không tìm thấy nhà cung cấp phù hợp.">
        <Header><th scope="col">Mã</th><th scope="col">Nhà cung cấp</th><th scope="col">Điện thoại</th><th scope="col">Địa chỉ</th><th scope="col">Thao tác</th></Header>
        <RowTemplate Context="supplier">
            <td>@supplier.Code</td>
            <td><strong>@supplier.Name</strong><small>@supplier.Email</small></td>
            <td>@supplier.Phone</td>
            <td>@supplier.Address</td>
            <td><div class="customer-row-actions">
                <button type="button" class="text-button" aria-label="Sửa @supplier.Code" @onclick="() => Edit(supplier)">Sửa</button>
                <button type="button" class="text-button customer-danger" aria-label="Xóa @supplier.Code" @onclick="() => deleting = supplier">Xóa</button>
            </div></td>
        </RowTemplate>
    </DataTable>
</section>

@if (editorOpen)
{
    <ModalDialog Label="@(editingId is null ? "Thêm nhà cung cấp" : "Sửa nhà cung cấp")" CssClass="customer-editor-modal" CloseOnBackdrop="false" OnClose="CloseEditor">
        <h2>@(editingId is null ? "Thêm nhà cung cấp" : "Sửa nhà cung cấp")</h2>
        <SupplierEditor Model="draft" IsEditing="@(editingId is not null)" Error="@formError" OnSave="Save" OnCancel="CloseEditor" />
    </ModalDialog>
}
@if (deleting is not null)
{
    <ModalDialog Label="Xác nhận xóa nhà cung cấp" CssClass="narrow" OnClose="() => deleting = null">
        <h2>Xóa nhà cung cấp?</h2>
        <p>Bạn đang xóa <strong>@deleting.Code — @deleting.Name</strong> khỏi danh sách demo của phiên này.</p>
        <div class="customer-actions">
            <button type="button" class="primary" @onclick="Delete">Xác nhận xóa</button>
            <button type="button" class="secondary" @onclick="() => deleting = null">Giữ lại</button>
        </div>
    </ModalDialog>
}
@code {
    private string query = "", message = "", formError = "";
    private bool editorOpen, failed;
    private int? editingId;
    private SupplierDraft draft = new();
    private Supplier? deleting, selectedLookup;
    private IReadOnlyList<Supplier> Rows => SupplierService.Search(query);

    private void Create()
    {
        editingId = null;
        draft = new SupplierDraft { Code = SupplierService.SuggestCode() };
        formError = "";
        editorOpen = true;
    }
    private void Edit(Supplier supplier)
    {
        editingId = supplier.Id;
        draft = SupplierDraft.From(supplier);
        formError = "";
        editorOpen = true;
    }
    private void CloseEditor() { editorOpen = false; formError = ""; }
    private void Save()
    {
        try
        {
            var saved = editingId is int id ? SupplierService.Update(id, draft) : SupplierService.Create(draft);
            if (selectedLookup?.Id == saved.Id) selectedLookup = saved;
            CloseEditor();
            query = "";
            Notice($"Đã lưu nhà cung cấp {saved.Code}.");
        }
        catch (InvalidOperationException ex) { formError = ex.Message; }
    }
    private void Delete()
    {
        if (deleting is null) return;
        try
        {
            var code = deleting.Code;
            SupplierService.Delete(deleting.Id);
            if (selectedLookup?.Id == deleting.Id) selectedLookup = null;
            deleting = null;
            Notice($"Đã xóa nhà cung cấp {code}.");
        }
        catch (InvalidOperationException ex) { deleting = null; Notice(ex.Message, true); }
    }
    private void Notice(string text, bool error = false) { message = text; failed = error; }
}
