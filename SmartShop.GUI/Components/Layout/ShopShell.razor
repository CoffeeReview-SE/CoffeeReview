@inherits ShopPageBase
<div class="announcement">Giao hàng miễn phí cho đơn từ 2 triệu <span>•</span> Bảo hành chính hãng <span>•</span> Trả góp 0%</div>
<header>
<a class="brand" href="/"><span class="brand-icon">S</span>Smart<span>Shop</span><small>TECHNOLOGY STORE</small></a>
<div class="search"><span>⌕</span><input aria-label="Tìm sản phẩm" placeholder="Bạn đang tìm sản phẩm gì?" @bind="query" @bind:event="oninput"/><kbd>⌕</kbd></div>
<button class="header-link" @onclick='()=>Go("account")'>♙ <span>Tài khoản</span></button><button class="cart-button" @onclick='()=>Go("cart")'>♧ <span>Giỏ hàng</span><b>@Shop.Count</b></button>
</header>
<div class="shell"><aside><div class="nav-caption">KHÁM PHÁ</div>
@foreach(var n in new[]{("home","⌂","Trang chủ"),("products","▦","Sản phẩm"),("orders","▤","Đơn hàng của tôi"),("favorites","♡","Yêu thích")}){<button class="nav-item @(page==n.Item1?"active":"")" @onclick="()=>Go(n.Item1)"><span>@n.Item2</span>@n.Item3</button>}
<div class="nav-caption">DANH MỤC SẢN PHẨM</div>
@foreach(var c in categories.Skip(1)){<button class="nav-item @(category==c&&page=="products"?"active":"")" @onclick="()=>Filter(c)"><span>@CategoryIcon(c)</span>@c<em>›</em></button>}
<div class="sidebar-bottom"><div class="help-card"><span>✧</span><strong>Cần tư vấn thêm?</strong><p>Mình luôn sẵn sàng hỗ trợ bạn.</p><button @onclick='()=>Go("support")'>Trung tâm hỗ trợ ↗</button></div><button class="nav-item" @onclick='()=>Go("admin")'><span>◫</span>Quản trị cửa hàng <em>↗</em></button><small>© 2026 SmartShop</small></div></aside>
<main><div class="breadcrumbs">SmartShop <span>/</span> @(page=="home"?"Trang chủ":PageName)</div>
@ChildContent
<footer><span class="brand-small">S <b>SmartShop</b></span><span>Công nghệ trong tầm tay.</span><small>Giao diện demo · C# / Blazor</small></footer></main></div>
<nav class="mobile-nav"><button @onclick='()=>Go("home")'>⌂<span>Trang chủ</span></button><button @onclick='()=>Go("products")'>▦<span>Sản phẩm</span></button><button @onclick='()=>Go("cart")'>♧<span>Giỏ hàng (@Shop.Count)</span></button><button @onclick='()=>Go("orders")'>▤<span>Đơn hàng</span></button><button @onclick='()=>Go("admin")'>◫<span>Admin</span></button></nav>
@if(selected is not null){var p=selected;<div class="overlay" @onclick="()=>selected=null"><section class="modal product-modal" role="dialog" aria-modal="true" aria-label="Chi tiết sản phẩm" @onclick:stopPropagation><button class="close" aria-label="Đóng" @onclick="()=>selected=null">×</button><div class="detail-art"><Device Color="@p.Color" Category="@p.Category"/></div><div><div class="eyebrow red">CHÍNH HÃNG · BẢO HÀNH 12 THÁNG</div><h1>@p.Name</h1><p>@p.Spec</p><div class="rating">★★★★★ <span>Được khách hàng yêu thích</span></div><h2 class="red">@ShopState.Money(p.Price)</h2><del>@ShopState.Money(p.Original)</del><p>Hiệu năng mạnh mẽ, thiết kế tinh tế. Sẵn sàng cho công việc và những trải nghiệm mỗi ngày.</p><div class="payment">◇ Chính hãng · ↻ Đổi trả 7 ngày</div><p class="muted">Còn @p.Stock sản phẩm · Hình minh họa</p><button class="primary wide" @onclick="()=>Add(p)">Thêm vào giỏ hàng +</button><button class="secondary wide" @onclick='()=>{if(Add(p)){selected=null;Go("cart");}}'>Mua ngay</button></div></section></div>}
@if(editing is not null){<div class="overlay"><section class="modal narrow" role="dialog" aria-modal="true" aria-label="Chỉnh sửa sản phẩm"><button class="close" aria-label="Đóng" @onclick="()=>editing=null">×</button><h2>@editing.Name</h2><label>Giá bán (₫)<input type="number" min="1" @bind="editPrice"/></label><label>Số lượng tồn<input type="number" min="0" @bind="editStock"/></label><p class="muted">Thay đổi chỉ áp dụng cho phiên demo hiện tại.</p><button class="primary" @onclick="SaveProduct">Lưu thay đổi</button></section></div>}
@if(toast!=""){<div class="toast" role="status">✓ @toast <button aria-label="Đóng thông báo" @onclick='()=>toast=""'>×</button></div>}

@code {
 [Parameter] public RenderFragment? ChildContent { get; set; }
}
