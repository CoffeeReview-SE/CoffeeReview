<article class="product-card">
    <div class="product-visual">
        @if (DiscountPercent > 0)
        {
            <span class="discount">-@DiscountPercent%</span>
        }
        <button type="button" class="favorite @(IsFavorite ? "liked" : "")"
                aria-label="Yêu thích @Product.Name" aria-pressed="@IsFavorite"
                @onclick="() => OnFavorite.InvokeAsync(Product.Id)">@(IsFavorite ? "♥" : "♡")</button>
        <button type="button" class="image-button" aria-label="Xem @Product.Name"
                @onclick="() => OnOpen.InvokeAsync(Product)">
            <Device Color="@Product.Color" Category="@Product.Category" />
        </button>
    </div>
    <div class="product-info">
        <span class="product-category">@Product.Category.ToUpperInvariant()</span>
        <button type="button" class="product-name" @onclick="() => OnOpen.InvokeAsync(Product)">@Product.Name</button>
        <p>@Product.Spec</p>
        <div class="rating">★★★★★ <span>(@((Product.Id * 37) + 12))</span></div>
        <div class="price-row">
            <div>
                <strong>@MoneyFormatter.Format(Product.Price)</strong>
                <del>@MoneyFormatter.Format(Product.Original)</del>
            </div>
            <button type="button" class="add-button" aria-label="Thêm @Product.Name vào giỏ"
                    @onclick="() => OnAdd.InvokeAsync(Product)">+</button>
        </div>
        <div class="stock"><i></i> Còn @Product.Stock sản phẩm <span>Chính hãng</span></div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public EventCallback<Product> OnOpen { get; set; }
    [Parameter] public EventCallback<Product> OnAdd { get; set; }
    [Parameter] public EventCallback<int> OnFavorite { get; set; }
    private int DiscountPercent => Product.Original <= 0 ? 0
        : Math.Max(0, (int)((1 - Product.Price / Product.Original) * 100));
}
