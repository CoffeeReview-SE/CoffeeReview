<div class="overlay" @onclick="HandleBackdrop" @onkeydown="HandleKey">
    <section class="modal @CssClass" role="dialog" aria-modal="true" aria-label="@Label"
             @onclick:stopPropagation>
        <button type="button" class="close" aria-label="Đóng" @onclick="OnClose">×</button>
        @ChildContent
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    private Task HandleBackdrop() => CloseOnBackdrop ? OnClose.InvokeAsync() : Task.CompletedTask;
    private Task HandleKey(KeyboardEventArgs e) => e.Key == "Escape"
        ? OnClose.InvokeAsync() : Task.CompletedTask;
}
