{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "apps/main.jsx",
    "apps/App.jsx",
    "apps/admin/**/*.jsx",
    "apps/admin/**/*.tsx",
    "apps/user-web/**/*.jsx",
    "apps/user-web/**/*.tsx"
  ]
}
