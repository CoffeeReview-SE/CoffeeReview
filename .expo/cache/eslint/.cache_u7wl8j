dmin\\OneDrive\\Documents\\test\\SmartShop\\app\\product_detail.tsx",[],[],"C:\\Users\\Admin\\OneDrive\\Documents\\test\\SmartShop\\app\\profile.tsx",[],[],"C:\\Users\\Admin\\OneDrive\\Documents\\test\\SmartShop\\app\\sign_up.tsx",[],[],"C:\\Users\\Admin\\OneDrive\\Documents\\test\\SmartShop\\app\\_layout.tsx",[],[],{"ruleId":"226","severity":1,"message":"227","line":108,"column":7,"nodeType":"228","messageId":"229","endLine":108,"endColumn":12},{"ruleId":"226","severity":1,"message":"230","line":267,"column":10,"nodeType":"228","messageId":"229","endLine":267,"endColumn":21},{"ruleId":"231","severity":1,"message":"232","line":490,"column":1,"nodeType":"233","endLine":490,"endColumn":52,"fix":"234"},{"ruleId":"226","severity":1,"message":"235","line":33,"column":6,"nodeType":"228","messageId":"229","endLine":33,"endColumn":16},{"ruleId":"226","severity":1,"message":"236","line":67,"column":16,"nodeType":"228","messageId":"229","endLine":67,"endColumn":21},{"ruleId":"237","severity":1,"message":"238","line":46,"column":6,"nodeType":"239","endLine":46,"endColumn":8,"suggestions":"240"},{"ruleId":"226","severity":1,"message":"241","line":3,"column":3,"nodeType":"228","messageId":"229","endLine":3,"endColumn":8,"suggestions":"242"},{"ruleId":"226","severity":1,"message":"243","line":16,"column":10,"nodeType":"228","messageId":"229","endLine":16,"endColumn":14},{"ruleId":"237","severity":1,"message":"238","line":30,"column":6,"nodeType":"239","endLine":30,"endColumn":8,"suggestions":"244"},"@typescript-eslint/no-unused-vars","'money' is assigned a value but never used.","Identifier","unusedVar","'AdminHeader' is defined but never used.","import/first","Import in body of module; reorder to top.","ImportDeclaration",{"range":"245","text":"246"},"'FilterType' is defined but never used.","'error' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'router'. Either include it or remove the dependency array.","ArrayExpression",["247"],"'Image' is defined but never used.",["248"],"'user' is assigned a value but never used.",["249"],[0,12726],"\r\nimport React, { useState } from \"react\";\r\nimport {\r\n  Alert,\r\n  Image,\r\n  Modal,\r\n  Pressable,\r\n  ScrollView,\r\n  StyleSheet,\r\n  Text,\r\n  View,\r\n  useWindowDimensions,\r\n} from \"react-native\";\r\nimport { Ionicons } from \"@expo/vector-icons\";\r\nimport Svg, {\r\n  Circle,\r\n  Path,\r\n  Polyline,\r\n} from \"react-native-svg\";\r\nimport { router } from \"expo-router\";\r\n\r\n// ===== COMPONENT HIỂN THỊ NHÃN TRONG SVG =====\r\nimport { Text as SvgText } from \"react-native-svg\";\r\n\r\n// ===== DỮ LIỆU THỐNG KÊ =====\r\n// Đây là dữ liệu mẫu để hiển thị giao diện dashboard.\r\n// Khi kết nối backend, có thể thay bằng dữ liệu lấy từ API.\r\nconst statistics = [\r\n  {\r\n    title: \"Tổng đơn hàng\",\r\n    value: \"128\",\r\n    percentage: \"12%\",\r\n    description: \"so với tháng trước\",\r\n    icon: \"cart-outline\" as const,\r\n    iconColor: \"#ed263d\",\r\n    iconBackground: \"#ffe4e7\",\r\n    positive: true,\r\n    chart: \"2,45 20,44 38,32 52,37 68,20 84,18 98,3\",\r\n  },\r\n  {\r\n    title: \"Đang xử lý\",\r\n    value: \"18\",\r\n    percentage: \"14%\",\r\n    description: \"tổng đơn\",\r\n    icon: \"wallet-outline\" as const,\r\n    iconColor: \"#ed263d\",\r\n    iconBackground: \"#fff0f1\",\r\n    positive: false,\r\n    chart: \"2,45 20,42 40,38 56,35 72,17 86,23 98,4\",\r\n  },\r\n  {\r\n    title: \"Đang giao\",\r\n    value: \"42\",\r\n    percentage: \"33%\",\r\n    description: \"tổng đơn\",\r\n    icon: \"car-outline\" as const,\r\n    iconColor: \"#ed263d\",\r\n    iconBackground: \"#fff0f1\",\r\n    positive: false,\r\n    chart: \"2,45 18,38 30,42 46,28 60,36 74,17 88,13 98,3\",\r\n  },\r\n  {\r\n    title: \"Đã hoàn thành\",\r\n    value: \"68\",\r\n    percentage: \"53%\",\r\n    description: \"tổng đơn\",\r\n    icon: \"checkmark-circle-outline\" as const,\r\n    iconColor: \"#ed263d\",\r\n    iconBackground: \"#fff0f1\",\r\n    positive: false,\r\n    chart: \"2,45 20,44 40,34 56,36 72,16 88,20 98,2\",\r\n  },\r\n];\r\n\r\n// ===== DỮ LIỆU BIỂU ĐỒ DOANH SỐ =====\r\nconst salesLabels = [\r\n  \"01/09\",\r\n  \"03/09\",\r\n  \"05/09\",\r\n  \"09/09\",\r\n  \"13/09\",\r\n  \"17/09\",\r\n  \"21/09\",\r\n  \"25/09\",\r\n  \"29/09\",\r\n];\r\n\r\nconst salesData = [\r\n  4000000,\r\n  6000000,\r\n  5500000,\r\n  9000000,\r\n  12000000,\r\n  10000000,\r\n  17000000,\r\n  9000000,\r\n  12000000,\r\n];\r\n\r\n// ===== DỮ LIỆU BIỂU ĐỒ DOANH SỐ THEO DANH MỤC =====\r\nconst categoryData = [\r\n  { label: \"Điện thoại\", value: 35, color: \"#ff2948\" },\r\n  { label: \"Laptop\", value: 25, color: \"#3b82f6\" },\r\n  { label: \"Phụ kiện\", value: 15, color: \"#10b981\" },\r\n  { label: \"Thiết bị game\", value: 10, color: \"#fbbf24\" },\r\n  { label: \"Đồng hồ\", value: 8, color: \"#8b5cf6\" },\r\n  { label: \"Khác\", value: 7, color: \"#94a3b8\" },\r\n];\r\n\r\n// ===== HÀM ĐỊNH DẠNG TIỀN TỆ =====\r\nconst money = (amount: number) =>\r\n  amount.toLocaleString(\"vi-VN\") + \"đ\";\r\n\r\n// ===== COMPONENT SIDEBAR =====\r\n// Thay thế thẻ <aside> và <nav> trong HTML.\r\nfunction Sidebar({\r\n  width,\r\n  activePage,\r\n}: {\r\n  width: number;\r\n  activePage: string;\r\n}) {\r\n  // Các mục điều hướng của trang quản trị\r\n  const menuItems = [\r\n    {\r\n      label: \"Tổng quan\",\r\n      icon: \"home-outline\" as const,\r\n      route: \"/main_Admin\",\r\n      page: \"main_Admin\",\r\n    },\r\n    {\r\n      label: \"Quản lý đơn hàng\",\r\n      icon: \"cart-outline\" as const,\r\n      route: \"/order_management\",\r\n      page: \"order_management\",\r\n    },\r\n    {\r\n      label: \"Quản lý sản phẩm\",\r\n      icon: \"cube-outline\" as const,\r\n      route: \"/product_management\",\r\n      page: \"product_management\",\r\n    },\r\n    {\r\n      label: \"Quản lý danh mục\",\r\n      icon: \"grid-outline\" as const,\r\n      route: \"/category_management\",\r\n      page: \"category_management\",\r\n    },\r\n    {\r\n      label: \"Quản lý khách hàng\",\r\n      icon: \"person-outline\" as const,\r\n      route: \"/customer_management\",\r\n      page: \"customer_management\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <View style={[styles.sidebar, { width }]}>\r\n      {/* Logo cửa hàng */}\r\n      <Pressable\r\n        style={styles.brand}\r\n        onPress={() => router.push(\"/main_Admin\")}\r\n      >\r\n        <Image\r\n          source={require(\"@/assets/image/logo.jpg\")}\r\n          style={styles.brandImage}\r\n          resizeMode=\"contain\"\r\n        />\r\n\r\n        <Text style={styles.brandText}>\r\n          BVP <Text style={styles.brandStrong}>Shop</Text>\r\n        </Text>\r\n      </Pressable>\r\n\r\n      {/* Menu điều hướng */}\r\n      <ScrollView\r\n        style={styles.sidebarMenu}\r\n        showsVerticalScrollIndicator={false}\r\n      >\r\n        {menuItems.map((item, index) => (\r\n          <React.Fragment key={item.page}>\r\n            {/* Nhóm quản lý */}\r\n            {index === 1 && (\r\n              <Text style={styles.menuHeading}>QUẢN LÝ</Text>\r\n            )}\r\n\r\n            {/* Các trang trong menu */}\r\n            <Pressable\r\n              style={[\r\n                styles.menuLink,\r\n                activePage === item.page && styles.menuLinkActive,\r\n              ]}\r\n              onPress={() => {\r\n                if (item.page !== activePage) {\r\n                  router.push(item.route as never);\r\n                }\r\n              }}\r\n            >\r\n              <Ionicons\r\n                name={item.icon}\r\n                size={20}\r\n                color={\r\n                  activePage === item.page ? \"#ffffff\" : \"#ed263d\"\r\n                }\r\n              />\r\n\r\n              <Text\r\n                numberOfLines={1}\r\n                style={[\r\n                  styles.menuLinkText,\r\n                  activePage === item.page &&\r\n                    styles.menuLinkTextActive,\r\n                ]}\r\n              >\r\n                {item.label}\r\n              </Text>\r\n            </Pressable>\r\n          </React.Fragment>\r\n        ))}\r\n\r\n        {/* Nhóm hệ thống */}\r\n        <Text style={styles.systemHeading}>HỆ THỐNG</Text>\r\n\r\n        {/* Đăng xuất */}\r\n        <Pressable\r\n          style={styles.menuLink}\r\n          onPress={() =>\r\n            Alert.alert(\r\n              \"Đăng xuất\",\r\n              \"Bạn có muốn đăng xuất khỏi hệ thống không?\",\r\n              [\r\n                { text: \"Hủy\", style: \"cancel\" },\r\n                {\r\n                  text: \"Đăng xuất\",\r\n                  style: \"destructive\",\r\n                  onPress: () => {\r\n                    // TODO: Kết nối chức năng đăng xuất tại đây.\r\n                    Alert.alert(\r\n                      \"Thông báo\",\r\n                      \"Hãy kết nối chức năng đăng xuất với hệ thống.\",\r\n                    );\r\n                  },\r\n                },\r\n              ],\r\n            )\r\n          }\r\n        >\r\n          <Ionicons\r\n            name=\"log-out-outline\"\r\n            size={20}\r\n            color=\"#ed263d\"\r\n          />\r\n          <Text style={styles.menuLinkText}>Đăng xuất</Text>\r\n        </Pressable>\r\n      </ScrollView>\r\n\r\n      {/* Thẻ giới thiệu phía dưới sidebar */}\r\n      <View style={styles.imageSide}>\r\n        <Image\r\n          source={require(\"@/assets/image/anh logo.png\")}\r\n          style={styles.promoImage}\r\n          resizeMode=\"contain\"\r\n        />\r\n      </View>\r\n    </View>\r\n  );\r\n}\r\n\r\n// ===== COMPONENT THANH HEADER =====\r\nfunction AdminHeader({ sidebarWidth }: { sidebarWidth: number }) {\r\n  return (\r\n    <View\r\n      style={[\r\n        styles.header,\r\n        {\r\n          marginLeft: sidebarWidth,\r\n          width: `100%`,\r\n        },\r\n      ]}\r\n    >\r\n      {/* Tài khoản Admin */}\r\n      <Pressable\r\n        style={styles.accountAdmin}\r\n        onPress={() =>\r\n          Alert.alert(\"Tài khoản\", \"Bạn đang đăng nhập với quyền Admin.\")\r\n        }\r\n      >\r\n        <View style={styles.accountIcon}>\r\n          <Ionicons\r\n            name=\"person\"\r\n            size={18}\r\n            color=\"#ed263d\"\r\n          />\r\n        </View>\r\n\r\n        <Text style={styles.accountName}>Admin</Text>\r\n      </Pressable>\r\n    </View>\r\n  );\r\n}\r\n\r\n// ===== COMPONENT BIỂU ĐỒ ĐƯỜNG NHỎ =====\r\n// Thay thế SVG mini-chart trong HTML.\r\nfunction MiniChart({ points }: { points: string }) {\r\n  return (\r\n    <Svg width={48} height={34} viewBox=\"0 0 100 50\">\r\n      <Polyline\r\n        points={points}\r\n        fill=\"none\"\r\n        stroke=\"#ffb5c0\"\r\n        strokeWidth={3}\r\n        strokeLinecap=\"round\"\r\n        strokeLinejoin=\"round\"\r\n      />\r\n    </Svg>\r\n  );\r\n}\r\n\r\n// ===== COMPONENT THẺ THỐNG KÊ =====\r\nfunction StatCard({\r\n  item,\r\n}: {\r\n  item: (typeof statistics)[number];\r\n}) {\r\n  return (\r\n    <View style={styles.statCard}>\r\n      {/* Icon của từng thẻ */}\r\n      <View\r\n        style={[\r\n          styles.statIcon,\r\n          { backgroundColor: item.iconBackground },\r\n        ]}\r\n      >\r\n        <Ionicons\r\n          name={item.icon}\r\n          size={19}\r\n          color={item.iconColor}\r\n        />\r\n      </View>\r\n\r\n      {/* Thông tin thống kê */}\r\n      <View style={styles.statInfo}>\r\n        <Text style={styles.statLabel}>{item.title}</Text>\r\n        <Text style={styles.statValue}>{item.value}</Text>\r\n\r\n        {/* Phần trăm thay đổi */}\r\n        <View style={styles.statChange}>\r\n          {item.positive && (\r\n            <Ionicons\r\n              name=\"arrow-up\"\r\n              size={12}\r\n              color=\"#16a34a\"\r\n            />\r\n          )}\r\n\r\n          <Text\r\n            style={[\r\n              styles.statPercentage,\r\n              {\r\n                color: item.positive ? \"#16a34a\" : \"#3985ef\",\r\n              },\r\n            ]}\r\n          >\r\n            {item.percentage}\r\n          </Text>\r\n\r\n          <Text style={styles.statDescription}>\r\n            {item.description}\r\n          </Text>\r\n        </View>\r\n      </View>\r\n\r\n      {/* Biểu đồ đường nhỏ bên phải */}\r\n      <View style={styles.miniChart}>\r\n        <MiniChart points={item.chart} />\r\n      </View>\r\n    </View>\r\n  );\r\n}\r\n\r\n// ===== COMPONENT BIỂU ĐỒ DOANH SỐ THEO NGÀY =====\r\nfunction SalesChart({ compact }: { compact: boolean }) {\r\n  // Kích thước biểu đồ thay đổi theo chiều rộng màn hình.\r\n  const chartWidth = compact ? 310 : 550;\r\n  const chartHeight = 240;\r\n  const paddingLeft = 48;\r\n  const paddingRight = 12;\r\n  const paddingTop = 18;\r\n  const paddingBottom = 36;\r\n\r\n  const plotWidth = chartWidth - paddingLeft - paddingRight;\r\n  const plotHeight = chartHeight - paddingTop - paddingBottom;\r\n\r\n  const maxValue = 20000000;\r\n  const yTicks = [0, 5000000, 10000000, 15000000, 20000000];\r\n\r\n  // Chuyển giá trị doanh số thành tọa độ x, y để vẽ biểu đồ.\r\n  const points = salesData.map((value, index) => {\r\n    const x =\r\n      paddingLeft +\r\n      (index / (salesData.length - 1)) * plotWidth;\r\n\r\n    const y =\r\n      paddingTop + plotHeight - (value / maxValue) * plotHeight;\r\n\r\n    return { x, y, value, label: salesLabels[index] };\r\n  });\r\n\r\n  // Tạo đường nối giữa các điểm dữ liệu.\r\n  const linePath = points\r\n    .map(\r\n      (point, index) =>\r\n        `${index === 0 ? \"M\" : \"L\"} ${point.x} ${point.y}`,\r\n    )\r\n    .join(\" \");\r\n\r\n  // Tạo vùng tô phía dưới đường doanh số.\r\n  const areaPath =\r\n    `${linePath} L ${points[points.length - 1].x} ` +\r\n    `${paddingTop + plotHeight} L ${paddingLeft} ` +\r\n    `${paddingTop + plotHeight} Z`;\r\n\r\n  return (\r\n    <View style={styles.salesChartContainer}>\r\n      <Svg\r\n        width=\"100%\"\r\n        height={chartHeight}\r\n        viewBox={`0 0 ${chartWidth} ${chartHeight}`}\r\n      >\r\n        {/* Các đường lưới và nhãn trục tung */}\r\n        {yTicks.map((tick) => {\r\n          const y =\r\n            paddingTop + plotHeight - (tick / maxValue) * plotHeight;\r\n\r\n          return (\r\n            <React.Fragment key={tick}>\r\n              <Path\r\n                d={`M ${paddingLeft} ${y} H ${chartWidth - paddingRight}`}\r\n                stroke=\"#edf0f5\"\r\n                strokeWidth={1}\r\n              />\r\n              <TextSvgLabel\r\n                x={paddingLeft - 7}\r\n                y={y + 4}\r\n                value={tick === 0 ? \"0\" : `${tick / 1000000}tr`}\r\n              />\r\n            </React.Fragment>\r\n          );\r\n        })}\r\n\r\n        {/* Vùng màu bên dưới đường doanh số */}\r\n        <Path d={areaPath} fill=\"#ff2948\" opacity={0.12} />\r\n\r\n        {/* Đường doanh số */}\r\n        <Path\r\n          d={linePath}\r\n          fill=\"none\"\r\n          stroke=\"#ff2948\"\r\n          strokeWidth={2.5}\r\n          strokeLinecap=\"round\"\r\n          strokeLinejoin=\"round\"\r\n        />\r\n\r\n        {/* Các điểm dữ liệu */}\r\n        {points.map((point, index) => (\r\n          <Circle\r\n            key={salesLabels[index]}\r\n            cx={point.x}\r\n            cy={point.y}\r\n            r={3.5}\r\n            fill=\"#ff2948\"\r\n            stroke=\"#ffffff\"\r\n            strokeWidth={1.5}\r\n          />\r\n        ))}\r\n\r\n        {/* Nhãn ngày ở trục hoành */}\r\n        {points.map((point, index) => (\r\n          <TextSvgLabel\r\n            key={point.label}\r\n            x={point.x}\r\n            y={chartHeight - 12}\r\n            value={compact ? point.label.slice(0, 2) : point.label}\r\n            anchor=\"middle\"\r\n          />\r\n        ))}\r\n      </Svg>\r\n    </View>\r\n  );\r\n}",{"desc":"250","fix":"251"},{"messageId":"252","data":"253","fix":"254","desc":"255"},{"desc":"250","fix":"256"},"Update the dependencies array to be: [router]",{"range":"257","text":"258"},"removeUnusedVar",{"varName":"259"},{"range":"260","text":"261"},"Remove unused variable \"Image\".",{"range":"262","text":"258"},[1004,1006],"[router]","Image",[54,60],"",[815,817]]