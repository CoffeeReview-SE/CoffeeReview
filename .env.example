# ---------- Frontend server (npm start, Railway runtime variables) ----------
# Use the actual private Gateway hostname and its listening port on Railway.
# Local npm start: http://127.0.0.1:5100. Vite dev already proxies /api locally.
API_GATEWAY_URL=http://127.0.0.1:5100
# Only set if Gateway:EdgeSecret is configured; never use a VITE_ prefix.
API_EDGE_SECRET=

# ---------- Gateway (services/gateway) ----------
# Admin routes (/api/admin/*) exist only when true. No login is used.
Admin__Enabled=false
Gateway__SharedKey=change-me-long-random
# Leave empty unless a proxy in front sends X-Edge-Secret
Gateway__EdgeSecret=
# Groq credentials stay in the gateway environment and must never use a VITE_ prefix.
Chat__GroqApiKey=
Chat__GroqModel=openai/gpt-oss-120b
# Web and admin origins allowed to call the gateway (your Railway frontend domain)
Cors__Origins__0=https://your-frontend.up.railway.app

# Service addresses. Local: localhost:5101-5105 (from appsettings.json).
# Railway: each service's private address, e.g. http://catalog.railway.internal:8080
ReverseProxy__Clusters__catalog__Destinations__d1__Address=http://localhost:5101
ReverseProxy__Clusters__localization__Destinations__d1__Address=http://localhost:5102
ReverseProxy__Clusters__review__Destinations__d1__Address=http://localhost:5103
ReverseProxy__Clusters__submission__Destinations__d1__Address=http://localhost:5104
ReverseProxy__Clusters__analytics__Destinations__d1__Address=http://localhost:5105

# ---------- Backend services (server side only, never in the frontend) ----------
# Supabase > Project Settings > Database
ConnectionStrings__Supabase=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require
# The C# services reach Supabase only through the connection string above.
# Do not put Supabase API keys (publishable or secret) in the frontend or in this file.
