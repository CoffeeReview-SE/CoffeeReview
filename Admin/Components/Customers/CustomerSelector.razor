<div class="customer-selector">
    <FormField Label="Khách hàng đã chọn">
        <input readonly value="@Display" aria-label="Khách hàng đã chọn" />
    </FormField>
    <button type="button" class="secondary" aria-label="Tìm và chọn khách hàng" @onclick="() => open = true">… Chọn khách hàng</button>
</div>
@if (open)
{
    <CustomerPicker OnlyActive="OnlyActive" OnSelected="Select" OnClose="() => open = false" />
}

@code {
    [Parameter] public Customer? Value { get; set; }
    [Parameter] public EventCallback<Customer?> ValueChanged { get; set; }
    [Parameter] public bool OnlyActive { get; set; } = true;
    private bool open;
    private string Display => Value is null ? "Chưa chọn khách hàng" : $"{Value.Code} — {Value.Name} — {Value.Phone}";
    private Task Select(Customer customer) => ValueChanged.InvokeAsync(customer);
}
