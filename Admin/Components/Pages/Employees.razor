@page "/admin/employees"
@layout SmartShop.Admin.Components.Layout.AdminLayout
@inject IEmployeeService EmployeeService

<PageTitle>Quản lý nhân viên — SmartShop</PageTitle>
<div class="section-heading customer-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / NHÂN VIÊN</div>
        <h1>Quản lý nhân viên</h1>
        <p class="subtitle">Quản lý hồ sơ, thông tin liên hệ và tình trạng làm việc.</p>
    </div>
    <button type="button" class="primary" @onclick="Create">+ Thêm nhân viên</button>
</div>
<p class="customer-help">Dữ liệu demo theo phiên. Tình trạng làm việc được quản lý độc lập với quyền đăng nhập.</p>
<div class="metrics customer-metrics">
    <div class="panel"><span>Tổng nhân viên</span><h2>@All.Count</h2></div>
    <div class="panel"><span>Đang làm việc</span><h2>@All.Count(c => c.IsActive)</h2></div>
    <div class="panel"><span>Ngừng làm việc</span><h2>@All.Count(c => !c.IsActive)</h2></div>
</div>
@if (!string.IsNullOrEmpty(message))
{
    <div class="customer-feedback @(failed ? "error" : "")" role="status">@message</div>
}
<section class="panel">
    <div class="customer-toolbar">
        <div class="customer-search"><input aria-label="Tìm nhân viên" placeholder="Tìm mã, họ tên, điện thoại, email..." @bind="query" @bind:event="oninput" /></div>
        <select aria-label="Lọc trạng thái nhân viên" @bind="statusFilter">
            <option value="all">Tất cả trạng thái</option><option value="active">Đang làm việc</option><option value="locked">Ngừng làm việc</option>
        </select>
        <button type="button" class="text-button" @onclick='() => { query = ""; statusFilter = "all"; }'>Xóa bộ lọc</button>
    </div>
    <EmployeeSelector @bind-Value="selectedLookup" OnlyActive="false" />
    @if (selectedLookup is not null)
    {
        <button type="button" class="text-button" @onclick="() => profile = selectedLookup">Xem hồ sơ đã chọn ↗</button>
    }
    <p class="customer-help">@Rows.Count kết quả · Có thể cuộn ngang bảng trên điện thoại.</p>
    <DataTable TItem="Employee" Items="Rows" Label="Danh sách nhân viên" ColumnCount="5" EmptyText="Không tìm thấy nhân viên phù hợp.">
        <Header><th scope="col">Mã</th><th scope="col">Nhân viên</th><th scope="col">Điện thoại</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></Header>
        <RowTemplate Context="employee">
            <td>@employee.Code</td>
            <td><strong>@employee.Name</strong><small>@employee.Email</small></td>
            <td>@employee.Phone</td>
            <td><span class="status @(employee.IsActive ? "" : "warning")">@(employee.IsActive ? "Đang làm" : "Ngừng làm việc")</span></td>
            <td><div class="customer-row-actions">
                <button type="button" class="text-button" aria-label="Xem hồ sơ @employee.Code" @onclick="() => profile = employee">Hồ sơ</button>
                <button type="button" class="text-button" aria-label="Sửa @employee.Code" @onclick="() => Edit(employee)">Sửa</button>
                <button type="button" class="text-button" aria-label="Đổi tình trạng @employee.Code" @onclick="() => Toggle(employee)">@(employee.IsActive ? "Ngừng làm" : "Làm lại")</button>
                <button type="button" class="text-button customer-danger" aria-label="Xóa @employee.Code" @onclick="() => deleting = employee">Xóa</button>
            </div></td>
        </RowTemplate>
    </DataTable>
</section>

@if (editorOpen)
{
    <ModalDialog Label="@(editingId is null ? "Thêm nhân viên" : "Sửa nhân viên")" CssClass="customer-editor-modal" CloseOnBackdrop="false" OnClose="CloseEditor">
        <h2>@(editingId is null ? "Thêm nhân viên" : "Sửa nhân viên")</h2>
        <EmployeeEditor Model="draft" IsEditing="@(editingId is not null)" Error="@formError" OnSave="Save" OnCancel="CloseEditor" />
    </ModalDialog>
}
@if (profile is not null)
{
    <ModalDialog Label="Hồ sơ nhân viên" CssClass="customer-editor-modal" OnClose="() => profile = null">
        <h2>Hồ sơ nhân viên</h2>
        <EmployeeProfile Value="profile" />
    </ModalDialog>
}
@if (deleting is not null)
{
    <ModalDialog Label="Xác nhận xóa nhân viên" CssClass="narrow" OnClose="() => deleting = null">
        <h2>Xóa nhân viên?</h2>
        <p>Bạn đang xóa <strong>@deleting.Code — @deleting.Name</strong> khỏi danh sách demo của phiên này.</p>
        <div class="customer-actions">
            <button type="button" class="primary" @onclick="Delete">Xác nhận xóa</button>
            <button type="button" class="secondary" @onclick="() => deleting = null">Giữ lại</button>
        </div>
    </ModalDialog>
}
@code {
    private string query = "", statusFilter = "all", message = "", formError = "";
    private bool editorOpen, failed;
    private int? editingId;
    private EmployeeDraft draft = new();
    private Employee? profile, deleting, selectedLookup;
    private IReadOnlyList<Employee> All => EmployeeService.Search();
    private IReadOnlyList<Employee> Rows => EmployeeService.Search(query, statusFilter switch { "active" => true, "locked" => false, _ => (bool?)null });

    private void Create()
    {
        editingId = null;
        draft = new EmployeeDraft { Code = EmployeeService.SuggestCode() };
        formError = "";
        editorOpen = true;
    }
    private void Edit(Employee employee)
    {
        editingId = employee.Id;
        draft = EmployeeDraft.From(employee);
        formError = "";
        editorOpen = true;
    }
    private void CloseEditor() { editorOpen = false; formError = ""; }
    private void Save()
    {
        try
        {
            var saved = editingId is int id ? EmployeeService.Update(id, draft) : EmployeeService.Create(draft);
            if (selectedLookup?.Id == saved.Id) selectedLookup = saved;
            CloseEditor();
            query = ""; statusFilter = "all";
            Notice($"Đã lưu nhân viên {saved.Code}.");
        }
        catch (InvalidOperationException ex) { formError = ex.Message; }
    }
    private void Toggle(Employee employee)
    {
        try
        {
            var saved = EmployeeService.SetActive(employee.Id, !employee.IsActive);
            if (selectedLookup?.Id == saved.Id) selectedLookup = saved;
            Notice($"{saved.Code}: {(saved.IsActive ? "đang làm việc" : "đã ngừng làm việc")}.");
        }
        catch (InvalidOperationException ex) { Notice(ex.Message, true); }
    }
    private void Delete()
    {
        if (deleting is null) return;
        try
        {
            var code = deleting.Code;
            EmployeeService.Delete(deleting.Id);
            if (selectedLookup?.Id == deleting.Id) selectedLookup = null;
            deleting = null;
            Notice($"Đã xóa nhân viên {code}.");
        }
        catch (InvalidOperationException ex) { deleting = null; Notice(ex.Message, true); }
    }
    private void Notice(string text, bool error = false) { message = text; failed = error; }
}

