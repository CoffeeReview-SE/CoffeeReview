@page "/admin"
@layout SmartShop.Admin.Components.Layout.AdminLayout
@inherits ShopPageBase
<PageTitle>@PageName — SmartShop</PageTitle>
<div class="section-heading">
    <div>
        <div class="eyebrow red">SMARTSHOP / ADMIN DEMO</div>
        <h1>Tổng quan cửa hàng</h1>
        <p class="subtitle">Một góc nhìn, mọi hoạt động.</p>
    </div>
    <span class="status">● Dữ liệu phiên hiện tại</span>
</div>
<div class="metrics">
    <div class="panel"><span>Doanh thu đơn demo</span><h2>@MoneyFormatter.Format(Shop.Orders.Sum(o => o.Total))</h2><small class="green">Tổng các đơn đã tạo</small></div>
    <div class="panel"><span>Đơn hàng</span><h2>@Shop.Orders.Count</h2><small>Trong phiên sử dụng</small></div>
    <div class="panel"><span>Sản phẩm</span><h2>@Shop.Products.Count</h2><small>4 danh mục đang kinh doanh</small></div>
    <div class="panel"><span>Tồn kho</span><h2>@Shop.Products.Sum(p => p.Stock)</h2><small>Sản phẩm có sẵn</small></div>
</div>
<ChoiceTabs Items="AdminTabs" @bind-Value="adminTab" CssClass="admin-tabs" />
<section class="panel">
    @if (adminTab == "Sản phẩm")
    {
        <div class="section-heading"><h2>Quản lý sản phẩm</h2><span class="muted">Cập nhật giá và tồn kho demo</span></div>
        <DataTable TItem="Product" Items="Filtered" Label="Danh sách sản phẩm" ColumnCount="5">
            <Header>
                <th scope="col">Sản phẩm</th><th scope="col">Danh mục</th><th scope="col">Giá bán</th><th scope="col">Tồn kho</th><th scope="col">Thao tác</th>
            </Header>
            <RowTemplate Context="product">
                <td><strong>@product.Name</strong><small>@product.Spec</small></td>
                <td>@product.Category</td>
                <td>@MoneyFormatter.Format(product.Price)</td>
                <td><span class="status @(product.Stock < 10 ? "warning" : "")">@product.Stock sản phẩm</span></td>
                <td><button class="text-button" @onclick="() => EditProduct(product)">Chỉnh sửa ↗</button></td>
            </RowTemplate>
        </DataTable>
    }
    else if (adminTab == "Đơn hàng")
    {
        <h2>Quản lý đơn hàng</h2>
        <DataTable TItem="Order" Items="Shop.Orders" Label="Danh sách đơn hàng" ColumnCount="4"
                   EmptyText="Chưa có đơn hàng. Hãy tạo đơn tại cửa hàng để thử quản lý.">
            <Header>
                <th scope="col">Mã đơn</th><th scope="col">Khách hàng</th><th scope="col">Tổng tiền</th><th scope="col">Trạng thái</th>
            </Header>
            <RowTemplate Context="order">
                <td><strong>@order.Code</strong></td>
                <td>@order.Customer</td>
                <td>@MoneyFormatter.Format(order.Total)</td>
                <td>
                    <select aria-label="Trạng thái @order.Code" value="@order.Status"
                            @onchange="e => UpdateOrderStatus(order.Code, e.Value?.ToString() ?? string.Empty)">
                        <option>Chờ xác nhận</option><option>Đã xác nhận</option><option>Đang giao hàng</option><option>Hoàn thành</option>
                    </select>
                </td>
            </RowTemplate>
        </DataTable>
    }
    else
    {
        <h2>Doanh thu theo danh mục</h2>
        <p class="muted">Tính từ đơn hàng demo trong phiên hiện tại.</p>
        @foreach (var item in categories.Skip(1))
        {
            var total = Shop.Orders.SelectMany(o => o.Items).Where(x => x.Product.Category == item).Sum(x => x.Product.Price * x.Quantity);
            var max = Math.Max(1, Shop.Orders.Sum(x => x.Total));
            <div class="chart-row">
                <span>@item</span>
                <div><i style="width:@((total / max * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                <strong>@MoneyFormatter.Format(total)</strong>
            </div>
        }
    }
</section>

@code {
    private static readonly string[] AdminTabs = ["Sản phẩm", "Đơn hàng", "Thống kê"];
}
