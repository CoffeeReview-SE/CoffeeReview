@page "/admin"
@inherits ShopPageBase
<PageTitle>@PageName — SmartShop</PageTitle>
<div class="section-heading"><div><div class="eyebrow red">SMARTSHOP / ADMIN DEMO</div><h1>Tổng quan cửa hàng</h1><p class="subtitle">Một góc nhìn, mọi hoạt động.</p></div><span class="status">● Dữ liệu phiên hiện tại</span></div><div class="metrics"><div class="panel"><span>Doanh thu đơn demo</span><h2>@ShopState.Money(Shop.Orders.Sum(o=>o.Total))</h2><small class="green">Tổng các đơn đã tạo</small></div><div class="panel"><span>Đơn hàng</span><h2>@Shop.Orders.Count</h2><small>Trong phiên sử dụng</small></div><div class="panel"><span>Sản phẩm</span><h2>@Shop.Products.Count</h2><small>4 danh mục đang kinh doanh</small></div><div class="panel"><span>Tồn kho</span><h2>@Shop.Products.Sum(p=>p.Stock)</h2><small>Sản phẩm có sẵn</small></div></div><div class="chips admin-tabs">@foreach(var t in new[]{"Sản phẩm","Đơn hàng","Thống kê"}){<button class="@(adminTab==t?"selected":"")" @onclick="()=>adminTab=t">@t</button>}</div>
<section class="panel">@if(adminTab=="Sản phẩm"){<div class="section-heading"><h2>Quản lý sản phẩm</h2><span class="muted">Cập nhật giá và tồn kho demo</span></div><div class="table-scroll"><table><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th></th></tr></thead><tbody>@foreach(var p in Filtered){<tr><td><strong>@p.Name</strong><small>@p.Spec</small></td><td>@p.Category</td><td>@ShopState.Money(p.Price)</td><td><span class="status @(p.Stock<10?"warning":"")">@p.Stock sản phẩm</span></td><td><button class="text-button" @onclick="()=>EditProduct(p)">Chỉnh sửa ↗</button></td></tr>}</tbody></table></div>}else if(adminTab=="Đơn hàng"){<h2>Quản lý đơn hàng</h2>@if(Shop.Orders.Count==0){<p class="muted">Chưa có đơn hàng. Hãy tạo đơn tại cửa hàng để thử quản lý.</p>}@foreach(var o in Shop.Orders){<div class="admin-order"><div><strong>@o.Code · @o.Customer</strong><p>@ShopState.Money(o.Total)</p></div><select aria-label="Trạng thái @o.Code" value="@o.Status" @onchange="e => UpdateOrderStatus(o.Code, e.Value?.ToString() ?? string.Empty)"><option>Chờ xác nhận</option><option>Đã xác nhận</option><option>Đang giao hàng</option><option>Hoàn thành</option></select></div>}}else{<h2>Doanh thu theo danh mục</h2><p class="muted">Tính từ đơn hàng demo trong phiên hiện tại.</p>@foreach(var c in categories.Skip(1)){var total=Shop.Orders.SelectMany(o=>o.Items).Where(x=>x.Product.Category==c).Sum(x=>x.Product.Price*x.Quantity);var max=Math.Max(1,Shop.Orders.Sum(x=>x.Total));<div class="chart-row"><span>@c</span><div><i style="width:@((total/max*100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div><strong>@ShopState.Money(total)</strong></div>}}</section>
