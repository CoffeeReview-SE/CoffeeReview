<dl class="customer-profile">
    <dt>Mã nhân viên</dt><dd>@Value.Code</dd>
    <dt>Họ và tên</dt><dd>@Value.Name</dd>
    <dt>Số điện thoại</dt><dd>@Value.Phone</dd>
    <dt>Email</dt><dd>@(string.IsNullOrEmpty(Value.Email) ? "Chưa cung cấp" : Value.Email)</dd>
    <dt>Địa chỉ</dt><dd>@Value.Address</dd>
    <dt>Trạng thái</dt><dd>@(Value.IsActive ? "Đang làm việc" : "Ngừng làm việc")</dd>
    <dt>Ngày tạo</dt><dd>@Value.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

@code {
    [Parameter, EditorRequired] public Employee Value { get; set; } = default!;
}
